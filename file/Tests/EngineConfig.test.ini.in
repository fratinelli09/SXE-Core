# Configuration generated by CMake for test @T_NAME@
[ENGINE]
mode   = SIM
symbol = BTCUSDT

[STRATEGY]
folder  = @T_STRATEGY_FOLDER@
library = @T_LIBRARY@
config  = @T_STRATEGY_CONFIG@

[PATH]
log    = @T_DIR@/Log
backup = @T_DIR@/Backup
data   = @T_DATA_DIR@

[EXCHANGE]
margin_mode        = @T_MARGIN@
fee_taker          = 0.0006
fee_maker          = 0.0002
slippage           = @T_SLIPPAGE@
maintenance_tiers  = @T_TIERS@
qty_step           = 0.0001
min_qty            = 0.0001
min_notional       = 5

[SIMULATION]
data_file       = @T_DATA_FILE@
funding_file    = BTCUSDT_funding_2023_2024.csv
state_file      = @T_DIR@/Log/last_row.txt
order_log       = @T_DIR@/Log/Set_Close_log.txt
resume          = @T_RESUME@
funding_rate    = 0.0001
funding_multiplier = @T_FUNDING_MULT@
initial_capital = @T_CAPITAL@
start_date      =
end_date        = @T_END_DATE@
intrabar        = @T_INTRABAR@
tick_step       = 0.002
liquidation     = @T_LIQUIDATION@
limit_fill      = @T_LIMIT_FILL@
save_every      = 500

[REAL]
script_dir       = .
env_file         = .
step_interval_ms = 1000

[LOG]
info    = 1
warning = 1
error   = 1
console = 0
